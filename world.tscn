script = ExtResource("1_f3sb7")
shader_code = "float linear_depth = get_linear_depth(depth);      
vec2 texel_size = 1.0 / vec2(size);
float depth_difference = 0.0;
vec3 normal_difference = vec3(0.0);
for (int i = 0; i < 4; i++) {
	// Calculating Edges
    depth_difference += linear_depth - get_linear_depth(neighbor_depths[i]);

	// Calculating Creases
	vec3 normal = get_raw_normal(texel);
	vec3 n_normal = neighbor_normals[i];
	normal_difference += normal - n_normal;
}
float edge = step(params.depth_threshold, depth_difference);
// Palette quantization
vec3 color_lab = rgb_to_oklab(color.rgb);
vec4 nearest = palette.colors[0];
float nearest_dist = distance(color_lab, rgb_to_oklab(nearest.rgb));
for (int i = 1; i < palette.colors.length(); i++) {
    float d = distance(color_lab, rgb_to_oklab(palette.colors[i].rgb));
    if (d < nearest_dist) {
        nearest_dist = d;
        nearest = palette.colors[i];
    }
}
color = nearest;
vec4 original_color = color;
float avg = dot(normal_difference, vec3(1.0 / 3.0));

if (edge > 0.0) {
    color.rgb = original_color.rgb * (1.0 - edge * 0.9);
} else if (avg > 0.1) {
    color.rgb = original_color.rgb * params.crease_multiplier;
}

"
pixel_size = 2
depth_threshold = 0.036
normal_threshold = 0.001
crease_multiplier = null
palette = Array[Color]([Color(0.09019608, 0.1254902, 0.21960784, 1), Color(0.14509805, 0.22745098, 0.36862746, 1), Color(0.23529412, 0.36862746, 0.54509807, 1), Color(0.30980393, 0.56078434, 0.7294118, 1), Color(0.4509804, 0.74509805, 0.827451, 1), Color(0.6431373, 0.8666667, 0.85882354, 1), Color(0.09803922, 0.2, 0.1764706, 1), Color(0.14509805, 0.3372549, 0.18039216, 1), Color(0.27450982, 0.50980395, 0.19607843, 1), Color(0.45882353, 0.654902, 0.2627451, 1), Color(0.65882355, 0.7921569, 0.34509805, 1), Color(0.8156863, 0.85490197, 0.5686275, 1), Color(0.3019608, 0.16862746, 0.19607843, 1), Color(0.47843137, 0.28235295, 0.25490198, 1), Color(0.6784314, 0.46666667, 0.34117648, 1), Color(0.7529412, 0.5803922, 0.4509804, 1), Color(0.84313726, 0.70980394, 0.5803922, 1), Color(0.90588236, 0.8352941, 0.7019608, 1), Color(0.20392157, 0.10980392, 0.15294118, 1), Color(0.3764706, 0.17254902, 0.17254902, 1), Color(0.53333336, 0.29411766, 0.16862746, 1), Color(0.74509805, 0.46666667, 0.16862746, 1), Color(0.87058824, 0.61960787, 0.25490198, 1), Color(0.9098039, 0.75686276, 0.4392157, 1), Color(0.14117648, 0.08235294, 0.15294118, 1), Color(0.25490198, 0.11372549, 0.19215687, 1), Color(0.45882353, 0.14117648, 0.21960784, 1), Color(0.64705884, 0.1882353, 0.1882353, 1), Color(0.8117647, 0.34117648, 0.23529412, 1), Color(0.85490197, 0.5254902, 0.24313726, 1), Color(0.11764706, 0.11372549, 0.22352941, 1), Color(0.2509804, 0.15294118, 0.31764707, 1), Color(0.47843137, 0.21176471, 0.48235294, 1), Color(0.63529414, 0.24313726, 0.54901963, 1), Color(0.7764706, 0.31764707, 0.5921569, 1), Color(0.8745098, 0.5176471, 0.64705884, 1), Color(0.03529412, 0.039215688, 0.078431375, 1), Color(0.0627451, 0.078431375, 0.12156863, 1), Color(0.08235294, 0.11372549, 0.15686275, 1), Color(0.1254902, 0.18039216, 0.21568628, 1), Color(0.22352941, 0.2901961, 0.3137255, 1), Color(0.34117648, 0.44705883, 0.46666667, 1), Color(0.5058824, 0.5921569, 0.5882353, 1), Color(0.65882355, 0.70980394, 0.69803923, 1)